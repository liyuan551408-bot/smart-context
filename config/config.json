{
  "embedding_provider": "siliconflow",
  "embedding_model": "BAAI/bge-m3",
  "embedding_base_url": "https://api.siliconflow.cn/v1",
  "candidate_k": 20,
  "top_k": 8,
  "max_context_tokens": 6000,
  "dependency_depth": 1,
  "chunker_version": "2",
  "semantic_chunking": {
    "enabled": true,
    "provider": "zhipu",
    "model": "glm-4-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "config_version": "1",
    "max_input_tokens": 6000,
    "min_chunk_tokens": 80,
    "target_chunk_tokens": 350,
    "max_chunk_tokens": 900,
    "hard_max_chunk_tokens": 1400,
    "max_chunks_per_region": 12,
    "confidence_threshold": 0.7,
    "cache_plans": true,
    "fallback_to_local": true,
    "max_retries": 2,
    "timeout_seconds": 45,
    "tiny_chunk_tokens": 55
  },
  "embedding_batch_size": 32,
  "chunk_lines": 100,
  "max_file_bytes": 1000000,
  "weights": {
    "semantic": 0.55,
    "dependency": 0.15,
    "git_recency": 0.15,
    "name_match": 0.1,
    "working_file": 0.05
  },
  "extensions": [
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".vue",
    ".py",
    ".java",
    ".kt",
    ".go",
    ".rs",
    ".c",
    ".cpp",
    ".h",
    ".cs",
    ".html",
    ".css",
    ".scss",
    ".json",
    ".yaml",
    ".yml",
    ".md",
    ".sql",
    ".prisma"
  ],
  "ignore_dirs": [
    ".git",
    "node_modules",
    "dist",
    "build",
    ".next",
    ".nuxt",
    "coverage",
    ".idea",
    ".vscode",
    "cache",
    "vendor",
    "target",
    "__pycache__",
    ".venv"
  ],
  "ignore_files": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Cargo.lock",
    "poetry.lock",
    "uv.lock",
    "composer.lock",
    "Gemfile.lock"
  ]
}
